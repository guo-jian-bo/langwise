{
    "nid": "ask_modal_subject_tell_listener_modal_could_to_response_clause_polarity",
    "pairTypeNid": "qa_pair",
    "pairType": {
        "nid": "qa_pair",
        "name": [
            {
                "lang": "zh",
                "text": "问答配对"
            },
            {
                "lang": "en",
                "text": "Question-Answer Pair"
            }
        ],
        "description": [
            {
                "lang": "zh",
                "text": "用于把一个问句和最直接的答句结构绑定成教学问答对。"
            },
            {
                "lang": "en",
                "text": "Links a question pattern with its most direct answer pattern for teaching."
            }
        ]
    },
    "name": [
        {
            "lang": "zh",
            "text": "Could you tell me…?（could）：用 Yes, … / No, … 对照肯否"
        },
        {
            "lang": "en",
            "text": "Could you tell me…? (could): contrast Yes, … / No, … by polarity"
        }
    ],
    "description": [
        {
            "lang": "zh",
            "text": "别人问 Could you tell me…?（could） 时，用 Yes, … 或 No, … 把肯否说完整。"
        },
        {
            "lang": "en",
            "text": "After Could you tell me…? (could), answer with a full Yes, … or No, …."
        }
    ],
    "order": 282000.0,
    "kind": "polarity",
    "sharedFrom": {
        "patternNid": "ask_modal_subject_tell_listener",
        "pattern": {
            "nid": "ask_modal_subject_tell_listener",
            "name": [
                {
                    "lang": "zh",
                    "text": "礼貌请求别人告知"
                },
                {
                    "lang": "en",
                    "text": "Politely Asking Someone to Tell You"
                }
            ],
            "description": [
                {
                    "lang": "zh",
                    "text": "礼貌请求对方告知信息的矩阵问句壳（Can/Could + 主语 + tell + 听话人）；其后的有限从句内容另作 dependent clause 分析，不塞进本。"
                },
                {
                    "lang": "en",
                    "text": "Polite matrix request shell with Can/Could + subject + tell + listener; any following finite content clause is a separate dependent clause."
                }
            ],
            "template": "{question_request_modal} {question_subject} tell {listener} {context_phrase} {time_expression}?"
        },
        "grammarFeatureNids": [
            "modal_could",
            "indicative_mood",
            "active_voice"
        ],
        "grammarFeatures": [
            {
                "nid": "modal_could",
                "name": [
                    {
                        "lang": "zh",
                        "text": "情态 could"
                    },
                    {
                        "lang": "en",
                        "text": "Modal Could"
                    }
                ],
                "description": [
                    {
                        "lang": "zh",
                        "text": "常表示过去能力、较委婉请求，或较弱的可能性与假设。"
                    },
                    {
                        "lang": "en",
                        "text": "Often expresses past ability, polite requests, or weaker possibility and hypothesis."
                    }
                ]
            },
            {
                "nid": "indicative_mood",
                "name": [
                    {
                        "lang": "zh",
                        "text": "陈述语气"
                    },
                    {
                        "lang": "en",
                        "text": "Indicative Mood"
                    }
                ],
                "description": [
                    {
                        "lang": "zh",
                        "text": "用于陈述事实、推断或一般信息，是英语中最常见的语气。"
                    },
                    {
                        "lang": "en",
                        "text": "Used to state facts, inferences, or general information; it is the most common mood in English."
                    }
                ]
            },
            {
                "nid": "active_voice",
                "name": [
                    {
                        "lang": "zh",
                        "text": "主动语态"
                    },
                    {
                        "lang": "en",
                        "text": "Active Voice"
                    }
                ],
                "description": [
                    {
                        "lang": "zh",
                        "text": "主语执行动作，表达更直接，常用于清楚说明施事者。"
                    },
                    {
                        "lang": "en",
                        "text": "The subject performs the action, giving a direct structure that clearly highlights the doer."
                    }
                ]
            }
        ]
    },
    "sharedToPatternNid": "response_clause",
    "sharedToPattern": {
        "nid": "response_clause",
        "name": [
            {
                "lang": "zh",
                "text": "用应答语带出完整一句"
            },
            {
                "lang": "en",
                "text": "Responding with a Marker Plus a Full Clause"
            }
        ],
        "description": [
            {
                "lang": "zh",
                "text": "先明确表示答应，再把后面的信息补完整，让回应更自然也更完整。"
            },
            {
                "lang": "en",
                "text": "Used to say yes first and then add a complete response."
            }
        ],
        "template": "{response_chunk}, {response_content}."
    },
    "contrastDimensionNid": "polarity",
    "contrastDimension": {
        "nid": "polarity",
        "name": [
            {
                "lang": "zh",
                "text": "肯定和否定怎样对照"
            },
            {
                "lang": "en",
                "text": "Affirmative vs Negative Contrast"
            }
        ],
        "description": [
            {
                "lang": "zh",
                "text": "用于比较同一个意思说成肯定或否定时的差异。"
            },
            {
                "lang": "en",
                "text": "Used to compare how the same idea changes between affirmative and negative forms."
            }
        ]
    },
