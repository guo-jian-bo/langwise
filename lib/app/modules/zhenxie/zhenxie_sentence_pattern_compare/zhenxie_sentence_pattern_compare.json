{
  "nid": "find_it_vs_it_be_adj",
  "dimensionNid": "find_it_vs_it_be_adj",
  "dimension": {
    "nid": "find_it_vs_it_be_adj",
    "name": [
      {
        "lang": "zh",
        "text": "find it 与 it is adj to do 近义"
      },
      {
        "lang": "en",
        "text": "Find It vs It Is Adjective to Do"
      }
    ],
    "description": [
      {
        "lang": "zh",
        "text": "同事同场景：某人觉得做某事怎么样，对照客观评价 It is adj to do。"
      },
      {
        "lang": "en",
        "text": "Same scene: someone finds an action a certain way versus an objective It is adj to do."
      }
    ]
  },
  "transformationKindNid": "realization",
  "transformationKind": {
    "nid": "realization",
    "name": [
      {
        "lang": "zh",
        "text": "同一条主线可以换哪些说法"
      },
      {
        "lang": "en",
        "text": "How One Learning Path Changes Form"
      }
    ],
    "description": [
      {
        "lang": "zh",
        "text": "用于说明同一学习主线下，不同实现说法之间怎样切换。"
      },
      {
        "lang": "en",
        "text": "Used to show how different realizations can appear within the same learning path."
      }
    ]
  },
  "contrastTypeNid": "nuance",
  "contrastType": {
    "nid": "nuance",
    "name": [
      {
        "lang": "zh",
        "text": "近义有差"
      },
      {
        "lang": "en",
        "text": "Near-synonym with a taught difference"
      }
    ],
    "description": [
      {
        "lang": "zh",
        "text": "同事、同场景，但必须画出可教的差别（如内在/外在义务、意愿/计划）。"
      },
      {
        "lang": "en",
        "text": "Same situation, but the picture must show the taught difference (e.g. inner vs outer obligation, intention vs plan)."
      }
    ]
  },
  "name": [
    {
      "lang": "zh",
      "text": "find it 和 it is adj to do 怎样对照"
    },
    {
      "lang": "en",
      "text": "Find It vs It Is Adjective to Do"
    }
  ],
  "description": [
    {
      "lang": "zh",
      "text": "同事同场景，对照「我觉得做某事怎么样」和客观评价 It is adj to do；图要画出主观觉得和客观评价。"
    },
    {
      "lang": "en",
      "text": "Same scene, contrasting I find it adj to do with objective It is adj to do."
    }
  ],
