  "teachingEntryInfo": {
    "patternNid": "find_it_adj_to_inf",
    "pattern": {
      "nid": "find_it_adj_to_inf",
      "name": [
        {
          "lang": "zh",
          "text": "觉得做某事怎么样（find it + adj + to do）"
        },
        {
          "lang": "en",
          "text": "Finding It Adjective to Do Something"
        }
      ],
      "description": [
        {
          "lang": "zh",
          "text": "形式宾语 it：find it + 形容词 + to do，说明某人觉得做某事容易、难或重要。与客观评价 It is adj to do、find + 宾语 + 补语区分。"
        },
        {
          "lang": "en",
          "text": "Formal object it: find it + adjective + to do. Distinct from objective It is adj to do and from find + object + complement."
        }
      ],
      "template": "{subject} {find_verb_marking} it {evaluative_adjective} to {evaluated_action} {context_phrase} {time_expression}."
    },
    "grammarFeatureNids": [
      "affirmative",
      "indicative_mood",
      "active_voice"
    ],
    "grammarFeatures": [
      {
        "nid": "affirmative",
        "name": [
          {
            "lang": "zh",
            "text": "肯定形式"
          },
          {
            "lang": "en",
            "text": "Affirmative"
          }
        ],
        "description": [
          {
            "lang": "zh",
            "text": "表示肯定、确认或直接陈述某事成立。"
          },
          {
            "lang": "en",
            "text": "Marks a positive statement, confirmation, or direct assertion that something holds true."
          }
        ]
      },
      {
        "nid": "indicative_mood",
        "name": [
          {
            "lang": "zh",
            "text": "陈述语气"
          },
          {
            "lang": "en",
            "text": "Indicative Mood"
          }
        ],
        "description": [
          {
            "lang": "zh",
            "text": "用于陈述事实、推断或一般信息，是英语中最常见的语气。"
          },
          {
            "lang": "en",
            "text": "Used to state facts, inferences, or general information; it is the most common mood in English."
          }
        ]
      },
      {
        "nid": "active_voice",
        "name": [
          {
            "lang": "zh",
            "text": "主动语态"
          },
          {
            "lang": "en",
            "text": "Active Voice"
          }
        ],
        "description": [
          {
            "lang": "zh",
            "text": "主语执行动作，表达更直接，常用于清楚说明施事者。"
          },
          {
            "lang": "en",
            "text": "The subject performs the action, giving a direct structure that clearly highlights the doer."
          }
        ]
      }
    ]
  },
