              "name": [
                {
                  "lang": "zh",
                  "text": "独立句"
                },
                {
                  "lang": "en",
                  "text": "Standalone Sentence"
                }
              ],
              "description": [
                {
                  "lang": "zh",
                  "text": "单独即可完成表达，不依赖上下文中的其他句子承担结构角色。"
                },
                {
                  "lang": "en",
                  "text": "Completes its communicative work on its own without depending on surrounding sentences for a structural role."
                }
              ]
            },
            {
              "nid": "scene_setting",
              "name": [
                {
                  "lang": "zh",
                  "text": "场景铺垫句"
                },
                {
                  "lang": "en",
                  "text": "Scene-Setting Sentence"
                }
              ],
              "description": [
                {
                  "lang": "zh",
                  "text": "用于交代时间、背景、环境或正在发生的情景，为后续内容铺垫语境。"
                },
                {
                  "lang": "en",
                  "text": "Used to establish time, background, environment, or an ongoing scene that frames what follows."
                }
              ]
            }
          ],
          "allowedFamilies": [
            {
              "nid": "identity_and_state",
              "name": [
                {
                  "lang": "zh",
                  "text": "说清是谁、怎样、指什么"
                },
                {
                  "lang": "en",
                  "text": "Saying Who or What It Is, and What It Means"
                }
              ],
              "description": [
                {
                  "lang": "zh",
                  "text": "这一组句型帮助学习者先交代人物、事物或概念是什么，再补充它现在怎么样、来自哪里，或某个词具体指什么。"
                },
                {
                  "lang": "en",
                  "text": "This group helps learners say who or what a person, thing, or idea is, then add its state, background, or meaning more clearly."
                }
              ]
            },
            {
              "nid": "existence_and_quantity",
              "name": [
                {
                  "lang": "zh",
                  "text": "说明有没有、多少、归谁"
                },
                {
                  "lang": "en",
                  "text": "Saying What There Is, How Much, and Who Has It"
                }
              ],
              "description": [
                {
                  "lang": "zh",
                  "text": "这一组句型帮助学习者说明某样东西有没有、数量是多少、价格多少，以及它在谁那里。"
                },
                {
                  "lang": "en",
                  "text": "This group helps learners say whether something is there, how much there is, what it costs, and who has it."
                }
              ]
            }
          ],
          "allowedPairTypeToNext": {
