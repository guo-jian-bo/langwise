                  "lang": "en",
                  "text": "Used to establish time, background, environment, or an ongoing scene that frames what follows."
                }
              ]
            }
          ],
          "allowedFamilies": [
            {
              "nid": "location_and_time",
              "name": [
                {
                  "lang": "zh",
                  "text": "说明在哪、何时、按什么顺序"
                },
                {
                  "lang": "en",
                  "text": "Saying Where, When, and In What Order"
                }
              ],
              "description": [
                {
                  "lang": "zh",
                  "text": "这一组句型帮助学习者把事情放到清楚的地点和时间里，再带着读者按顺序看完整个过程。"
                },
                {
                  "lang": "en",
                  "text": "This group helps learners place events in clear time and place, then guide the reader through the steps in the right order."
                }
              ]
            },
            {
              "nid": "action_and_experience",
              "name": [
                {
                  "lang": "zh",
                  "text": "讲动作、经历和变化"
                },
                {
                  "lang": "en",
                  "text": "Talking About Actions, Experience, and Change"
                }
              ],
              "description": [
                {
                  "lang": "zh",
                  "text": "这一组句型帮助学习者讲清楚眼前正在发生什么、平时通常怎么做、过去经历过什么，以及这些经历和现在有什么联系。"
                },
                {
                  "lang": "en",
                  "text": "This group helps learners talk about what is happening now, what people usually do, what happened before, and how past experience still connects to the present."
                }
              ]
            }
          ],
          "allowedPairTypeToNext": {
