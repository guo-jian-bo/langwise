  "name": [
    {
      "lang": "zh",
      "text": "说明是谁 / 是什么"
    },
    {
      "lang": "en",
      "text": "Say who or what it is"
    }
  ],
  "description": [
    {
      "lang": "zh",
      "text": "用来给人或事物下身份：它是谁、是什么角色或什么东西。"
    },
    {
      "lang": "en",
      "text": "Identifies someone or something — who they are or what it is."
    }
  ],
  "tenseScope": "neutral",
  "predicateRealizationProfile": {
    "kind": "copular_be",
    "predicateSlotKey": null,
