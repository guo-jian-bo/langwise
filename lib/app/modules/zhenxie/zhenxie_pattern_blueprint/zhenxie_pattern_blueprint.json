  "predicateRealizationProfileInfo": {
    "kind": "copular_be",
    "predicateSlotKey": null,
    "predicateSlot": null,
    "operatorSlotKeys": [
      "copula_be",
      "copula_be_negative"
    ],
    "operatorSlots": [
      {
        "nid": "copula_be",
        "name": [
          {
            "lang": "zh",
            "text": "是"
          },
          {
            "lang": "en",
            "text": "be (linking)"
          }
        ],
        "description": [
          {
            "lang": "zh",
            "text": "把主语和身份、状态连起来，说明「是什么 / 怎么样」。am / is / was / will be / going to be 合在这一格，因为合起来才是「是」的完整时体，整块记，不要拆成 will 和 be。例如 He is my brother. / It will be sunny tomorrow."
          },
          {
            "lang": "en",
            "text": "Links the subject to an identity or state. am / is / was / will be / going to be sit in one hole because together they are the linking verb’s full tense-aspect — remember the chunk, don’t split will from be. Example: He is my brother. / It will be sunny tomorrow."
          }
        ],
        "categoryNid": "grammar_auxiliary",
        "color": "rgba(245,158,11,1)",
        "categoryName": [
          {
            "lang": "zh",
            "text": "助动语法形式"
          },
          {
            "lang": "en",
            "text": "Auxiliary Grammar Form"
          }
        ],
        "categoryDescription": [
          {
            "lang": "zh",
            "text": "用于控制 be、do、have、存在式或附加问句中的助动形式。"
          },
          {
            "lang": "en",
            "text": "Controls auxiliary forms for be, do, have, existential frames, or tag questions."
          }
        ]
      },
      {
        "nid": "copula_be_negative",
        "name": [
          {
            "lang": "zh",
            "text": "不是"
          },
          {
            "lang": "en",
            "text": "isn't"
          }
        ],
        "description": [
          {
            "lang": "zh",
            "text": "说明「不是什么 / 不怎么样」。isn't / wasn't / won't be / not going to be 合在这一格，因为合起来才是否定「是」的完整时体，整块记。例如 This is not my pen. / This won't be easy."
          },
          {
            "lang": "en",
            "text": "Says it is not that identity or state. isn't / wasn't / won't be / not going to be sit in one hole because together they are the linking verb’s full tense-aspect — remember the chunk. Example: This is not my pen. / This won't be easy."
          }
        ],
        "categoryNid": "negative_auxiliary",
        "color": "rgba(245,158,11,1)",
        "categoryName": [
          {
            "lang": "zh",
            "text": "显式否定语法形式"
          },
          {
            "lang": "en",
            "text": "Explicit Negative Grammar Form"
          }
        ],
        "categoryDescription": [
          {
            "lang": "zh",
            "text": "用于直接承载否定完整式、缩写与允许的否定 clitic。"
          },
          {
            "lang": "en",
            "text": "Directly carries full negative forms, contractions, and allowed negative clitics."
          }
        ]
      }
    ]
  },
