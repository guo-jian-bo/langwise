{
  "nid": "identify_entity_as_np",
  "familyNid": "identity_and_state",
  "family": {
    "nid": "identity_and_state",
    "name": [
      {
        "lang": "zh",
        "text": "说清是谁、怎样、指什么"
      },
      {
        "lang": "en",
        "text": "Saying Who or What It Is, and What It Means"
      }
    ],
    "description": [
      {
        "lang": "zh",
        "text": "这一组句型帮助学习者先交代人物、事物或概念是什么，再补充它现在怎么样、来自哪里，或某个词具体指什么。"
      },
      {
        "lang": "en",
        "text": "This group helps learners say who or what a person, thing, or idea is, then add its state, background, or meaning more clearly."
      }
    ]
  },
  "difficulty": {
    "max": 1,
    "min": 0
  },
  "order": 559000,
  "blueprintScope": "clause",
  "patternTier": "core",
  "analysisEligible": true,
