    "name": [
        {
            "lang": "zh",
            "text": "look forward to，不是 for"
        },
        {
            "lang": "en",
            "text": "Look Forward To, Not For"
        }
    ],
    "description": [
        {
            "lang": "zh",
            "text": "表示期待，后面要接 to。写成 look forward for 是常见错写。"
        },
